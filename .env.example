# Copy to .env and fill in. Only needed for `python src/benchmark.py --live`.

# openai | custom | gemini | anthropic | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Optional judge model (defaults to the main provider/model)
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini

OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Compact memory
COMPACT_THRESHOLD_TOKENS=800
COMPACT_KEEP_MESSAGES=4
